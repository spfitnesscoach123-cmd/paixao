{
  "compilerOptions": {
    "allowSyntheticDefaultImports": true,
    "declaration": true,
    "esModuleInterop": true,
    "jsx": "react-native",
    "lib": ["ES2020"],
    "moduleResolution": "node",
    "outDir": "./build",
    "strict": true,
    "target": "ESNext",
    "skipLibCheck": true
  },
  "include": ["src"]
}
